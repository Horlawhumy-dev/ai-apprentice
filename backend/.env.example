APP_NAME=AI Apprentice API
ENVIRONMENT=development
# PostgreSQL. Use a unix socket (peer auth) or full TCP URL.
# DATABASE_URL=postgresql+psycopg2:///ai_apprentice
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_apprentice
FRONTEND_ORIGIN=http://localhost:3000
# Comma-separated extra origins allowed to POST captured events (SDK). In dev any origin is allowed.
EXTRA_ALLOWED_ORIGINS=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Interviewer LLM (Anthropic Messages API). Leave LLM_API_KEY blank for deterministic mode.
LLM_API_KEY=
LLM_BASE_URL=https://api.anthropic.com
LLM_MODEL=claude-3-5-sonnet-latest
