APP_NAME=AI Apprentice API
ENVIRONMENT=development
# PostgreSQL. The unix socket uses peer auth as your OS user, which is the
# usual local setup. Use a TCP URL for a hosted database (add ?sslmode=require
# for Neon/Supabase) - a TCP URL also needs a password that actually matches.
DATABASE_URL=postgresql:///ai_apprentice
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_apprentice
FRONTEND_ORIGIN=http://localhost:3000
# Comma-separated extra origins allowed to POST captured events (SDK). In dev any origin is allowed.
EXTRA_ALLOWED_ORIGINS=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Interviewer LLM (Anthropic Messages API). Leave LLM_API_KEY blank for deterministic mode.
LLM_API_KEY=
LLM_BASE_URL=https://api.anthropic.com
LLM_MODEL=claude-haiku-4-5
